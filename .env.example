# ============================================================================
# MintPulse — Open-Source Discord NFT Mint Reminder Bot (.env.example)
# Copy this file to .env and provide your configuration values.
# NEVER commit real secrets, tokens, or private keys to version control.
# ============================================================================

# --- Discord Bot Configuration ---
# Create an application at https://discord.com/developers/applications
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_CLIENT_ID_HERE"

# Optional: Guild ID for instant development slash-command registration
DISCORD_DEV_GUILD_ID=""

# --- PostgreSQL Persistence ---
# Standard connection URI for PostgreSQL 14+
DATABASE_URL="postgresql://mintpulse:mintpulse_password@localhost:5432/mintpulse"

# --- Discovery Engine & External Data Sources ---
# OpenSea REST API v2 Key (https://docs.opensea.io/reference/api-keys)
OPENSEA_API_KEY="YOUR_OPENSEA_API_KEY_HERE"

# Comma-separated list of approved custom mint feed or drop manifest URLs
CUSTOM_MINT_FEED_URLS=""

# Polling interval in minutes for automated discovery runs (default: 15)
DISCOVERY_INTERVAL_MINUTES="15"

# --- Reminder Scheduler & Reliability ---
# Default reminder intervals before mint start in minutes (24h=1440, 1h=60, 15m=15)
DEFAULT_REMINDER_INTERVALS="1440,60,15"

# Grace window in minutes for recovering overdue reminders after bot downtime
OVERDUE_GRACE_MINUTES="30"

# Polling frequency in seconds for reminder dispatch worker
SCHEDULER_POLL_SECONDS="30"

# --- Server & Observability ---
PORT="3000"
LOG_LEVEL="info"
APP_URL="http://localhost:3000"
